{
  "name": "a11y-audit",
  "version": "0.1.0",
  "description": "WCAG 2.1/2.2 AA accessibility scanner: automated axe-core scans plus manual/semi-automated checks axe misses, scored HTML/JSON/CSV reports, CI-gateable CLI.",
  "type": "module",
  "private": true,
  "bin": {
    "a11y-audit": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "npm run build && node dist/cli.js",
    "start": "node dist/cli.js"
  },
  "license": "MIT",
  "dependencies": {
    "@axe-core/playwright": "^4.10.0",
    "commander": "^12.1.0",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
